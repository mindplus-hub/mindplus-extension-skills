{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindplus-agent.extension-spec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "mode", "blocks", "dependencies", "devices", "assets"],
  "properties": {
    "schema_version": {"const": "mindplus-agent.extension-spec/v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+$"},
        "author": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z]+$"},
        "version": {"type": "string", "minLength": 1},
        "compatibility_id": {"type": ["string", "null"], "default": "", "description": "Empty unless an existing V1 compatibility target has been confirmed; never derive from the new author/id alone."}
      }
    },
    "mode": {"enum": ["UPLOAD", "PYTHON_BLOCK"]},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opcode", "block_type", "message_id", "parameters", "generator_claim"],
        "properties": {
          "opcode": {"type": "string", "minLength": 1},
          "block_type": {"type": "string", "minLength": 1},
          "message_id": {"type": "string", "minLength": 1},
          "parameters": {"type": "array", "items": {"type": "object"}},
          "generator_claim": {"type": "string", "minLength": 1},
          "boards": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Board visibility conditions; values must be device-ids.json entries."
          },
          "submenu": {
            "type": ["string", "null"],
            "description": "SUBMENU id this block belongs to (see references/switch/block-organization.md)."
          }
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "devices": {"type": "array", "items": {"type": "object"}},
    "assets": {"type": "array", "items": {"type": "object"}},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color1": {"type": "string", "description": "Primary block color, e.g. #00B0F0."}
      }
    },
    "reference_features": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Explicit reference-bundle feature ids (e.g. event-callback, advanced) the selection should load in addition to the derived ones."
    },
    "readme_claims": {"type": "array", "items": {"type": "string"}},
    "review_profile": {"enum": ["BASIC", "HOST_READY"], "default": "BASIC", "description": "Use HOST_READY only when explicitly requested; do not inherit it from a template."}
  }
}
