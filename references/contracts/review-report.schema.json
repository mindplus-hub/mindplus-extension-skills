{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindplus-agent.review-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_root", "source_type", "source_sha256", "status", "profile_achieved", "checks", "findings"],
  "properties": {
    "schema_version": {"const": "mindplus-agent.review-report/v1"},
    "project_root": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["CONVERTED_FROM_V1", "CREATED_FROM_SPEC", "EXISTING_V2_UNKNOWN"]},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "commit": {"type": ["string", "null"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "profile_achieved": {"enum": ["NONE", "SOURCE_READY", "HOST_READY", "DEVICE_READY"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "location", "claim", "evidence", "impact", "recheck"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "INFO"]},
          "location": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "impact": {"type": "string"},
          "recheck": {"type": "string"}
        }
      }
    }
  }
}
