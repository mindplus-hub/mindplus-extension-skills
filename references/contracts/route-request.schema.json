{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindplus-agent.route-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["goals", "paths", "authorizations"],
  "properties": {
    "review_profile": {"enum": ["BASIC", "HOST_READY"], "default": "BASIC"},
    "goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CONVERT", "CREATE", "REVIEW", "PUBLISH", "SYNC"]}
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root"],
      "properties": {
        "v1_source": {"type": ["string", "null"]},
        "project_root": {"type": ["string", "null"]},
        "extension_spec": {"type": ["string", "null"]},
        "review_handoff": {"type": ["string", "null"]}
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_write": {"type": "boolean"},
        "install": {"type": "boolean"},
        "build": {"type": "boolean"},
        "mindplus_ui": {"type": "boolean"},
        "commit": {"type": "boolean"},
        "create_repository": {"type": "boolean"},
        "push": {"type": "boolean"},
        "device_upload": {"type": "boolean"}
      }
    }
  }
}
