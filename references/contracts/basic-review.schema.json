{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindplus.review-basic/v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_root",
    "project_sha256",
    "artifact",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "mindplus.review-basic/v1"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "project_root": {
      "type": "string"
    },
    "project_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "maximum": 5000000
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "config_schema",
        "extension_static_integrity",
        "source_semantics",
        "malicious_code_review",
        "builder_build",
        "blocks_visible",
        "blocks_functional"
      ],
      "properties": {
        "config_schema": {
          "$ref": "#/$defs/check"
        },
        "extension_static_integrity": {
          "$ref": "#/$defs/check"
        },
        "source_semantics": {
          "$ref": "#/$defs/check"
        },
        "malicious_code_review": {
          "$ref": "#/$defs/check"
        },
        "builder_build": {
          "$ref": "#/$defs/check"
        },
        "blocks_visible": {
          "$ref": "#/$defs/check"
        },
        "blocks_functional": {
          "$ref": "#/$defs/check"
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "result",
        "method",
        "summary",
        "evidence"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "BLOCKED"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "exit_code": {
          "type": "integer"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
